# Reports scheduling
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_CRON=0 0 16 * * 0
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_CRON=0 0 6 1 * *
REPORTS_TIMEZONE=Europe/Moscow
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_DOMAIN=

TELEGRAM_MASTER_BOT_TOKEN=

DATABASE_URL=

OPENAI_API_KEY=

# Sentry Configuration
SENTRY_DSN=
NODE_ENV=development
SENTRY_RELEASE=
SENTRY_ENABLE_TRACING=true
SENTRY_ENABLE_PROFILING=false
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Sentry CLI Configuration (for source maps)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=